# Supabase project — Settings -> API. Service role key only, never the anon
# key (this app never talks to Supabase from the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kit (ConvertKit) — Settings -> Developer. One form for all leads; a tag
# per result state (S0-S4) for branching follow-up sequences via Kit's
# Visual Automations. Any of these may be left unset — the lead capture
# route skips whichever Kit calls it can't make and still stores the lead.
KIT_API_KEY=
KIT_FORM_ID=
KIT_TAG_ID_S0=
KIT_TAG_ID_S1=
KIT_TAG_ID_S2=
KIT_TAG_ID_S3=
KIT_TAG_ID_S4=
